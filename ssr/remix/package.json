{
	"name": "remix",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"format": "prettier --check app/**",
		"lint": "tsc --noEmit",
		"prepare": "npm-run-all2 prepare:*",
		"prepare:components-assets": "cpy \"node_modules/@public-ui/components/assets/**/*\" public/assets --dot",
		"prepare:theme-assets": "cpy \"node_modules/@public-ui/theme-default/assets/**/*\" public/assets --dot",
		"start": "react-router-serve ./build/server/index.js",
		"stylelint": "stylelint \"app/**/*.{css,scss}\""
	},
	"dependencies": {
		"@public-ui/components": "4.2.1",
		"@public-ui/react-v19": "4.2.1",
		"@public-ui/theme-default": "4.2.1",
		"@react-router/node": "8.3.0",
		"@react-router/serve": "8.3.0",
		"isbot": "5.2.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.0"
	},
	"devDependencies": {
		"@react-router/dev": "8.3.0",
		"@types/node": "26.0.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"cpy-cli": "7.0.0",
		"npm-run-all2": "9.0.3",
		"prettier": "3.9.6",
		"stylelint": "16.26.1",
		"stylelint-config-recommended-scss": "16.0.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-scss": "6.14.0",
		"typescript": "5.9.3",
		"vite": "8.2.0"
	}
}
