{
	"name": "astro.js",
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --check \"src/**\"",
		"lint": "tsc --noEmit",
		"stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"prepare": "npm-run-all2 prepare:*",
		"prepare:components-assets": "cpy \"node_modules/@public-ui/components/assets/**/*\" src/assets --dot",
		"prepare:theme-assets": "cpy \"node_modules/@public-ui/theme-default/assets/**/*\" src/assets --dot"
	},
	"dependencies": {
		"@public-ui/components": "4.2.1",
		"@public-ui/react-v19": "4.2.1",
		"@public-ui/theme-default": "4.2.1",
		"react": "19.2.2",
		"react-dom": "19.2.2"
	},
	"devDependencies": {
		"@astrojs/react": "6.0.2",
		"@astrojs/check": "0.9.10",
		"@types/node": "26.0.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"astro": "7.1.6",
		"cpy-cli": "7.0.0",
		"npm-run-all2": "9.0.3",
		"prettier": "3.9.6",
		"unocss": "66.7.5",
		"typescript": "5.9.3",
		"stylelint": "16.26.1",
		"stylelint-config-recommended-scss": "16.0.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-scss": "6.14.0"
	}
}
