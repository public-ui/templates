{
	"name": "vue-vite",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc && vite build",
		"dev": "vite",
		"format": "prettier --check src",
		"lint": "tsc --noemit",
		"stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"preview": "vite preview",
		"start": "npm run dev",
		"unused": "knip"
	},
	"dependencies": {
		"@public-ui/components": "4.3.0",
		"@public-ui/theme-default": "4.3.0",
		"@public-ui/vue": "4.3.0",
		"vue": "3.5.41"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "6.0.8",
		"@vue/tsconfig": "0.9.1",
		"adopted-style-sheets": "1.1.9-rc.25",
		"knip": "6.32.0",
		"prettier": "3.9.6",
		"unocss": "66.7.5",
		"typescript": "5.9.3",
		"vite": "8.2.1",
		"stylelint": "16.26.1",
		"stylelint-config-recommended-scss": "16.0.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-scss": "6.14.0"
	}
}
