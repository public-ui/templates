{
	"name": "react-standalone",
	"version": "0.0.0",
	"scripts": {
		"prepare": "npm-run-all2 prepare:*",
		"prepare:components-assets": "cpy \"node_modules/@public-ui/components/assets/**/*\" assets --dot",
		"prepare:theme-assets": "cpy \"node_modules/@public-ui/theme-default/assets/**/*\" assets --dot",
		"start": "serve",
		"stylelint": "stylelint \"style.css\""
	},
	"dependencies": {
		"@public-ui/components": "4.2.1",
		"@public-ui/theme-default": "4.2.1"
	},
	"devDependencies": {
		"cpy-cli": "7.0.0",
		"npm-run-all2": "9.0.3",
		"serve": "14.2.6",
		"stylelint": "16.26.1",
		"stylelint-config-recommended-scss": "16.0.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-scss": "6.14.0"
	}
}
